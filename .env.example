# Referral creation API (server-only; never prefix these with NEXT_PUBLIC_)
SERVICE_BASE_URL=https://api.schoolofai.so
SERVICE_TOKEN=
SERVICE_REQUEST_TIMEOUT_MS=10000

# Server-side (used for plain REST fetches in app/data.ts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser + middleware (Supabase Auth session handling) — same project, must be NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed once, to run: npm run seed:admin
# Configure the seed administrator credentials outside source control.
